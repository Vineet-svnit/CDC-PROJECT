<% layout("/layouts/userBoilerplate") %>

    <main class="py-5">
        <div class="container-lg">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card border-0 shadow-lg text-center p-4"
                        style="border-radius: 20px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                        <div class="card-body">
                            <!-- Icon Header -->
                            <div class="mb-4">
                                <div class="bg-warning bg-opacity-10 d-inline-block p-4 rounded-circle mb-3">
                                    <i class="fas fa-shield-alt fa-3x text-warning"></i>
                                </div>
                                <h2 class="fw-bold mb-2" style="color: #27496d;">Safe Exam Browser Required</h2>
                                <p class="text-muted">To ensure a fair and secure testing environment, this exam must be
                                    taken using the Safe Exam Browser (SEB).</p>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-grid gap-3 mb-4">
                                <!-- Step 1: Download Configuration -->
                                <div class="text-start p-3 border rounded-3 bg-light">
                                    <h6 class="fw-bold mb-2 text-primary"><i class="fas fa-file-download me-2"></i>Step
                                        1: Get Configuration</h6>
                                    <p class="small text-muted mb-3">Download and open this file to launch the exam in
                                        SEB.</p>
                                    <a href="/SEB/CDC.seb" class="btn btn-primary w-100 py-2 fw-semibold" download>
                                        Download CDC Config File
                                    </a>
                                </div>

                                <!-- Step 2: Download App (If needed) -->
                                <div class="text-start p-3 border rounded-3">
                                    <h6 class="fw-bold mb-2 text-secondary"><i class="fas fa-desktop me-2"></i>Step 2:
                                        Install SEB (If not installed)</h6>
                                    <p class="small text-muted mb-3">If you haven't installed the Safe Exam Browser
                                        application yet, download it from the official site.</p>
                                    <a href="https://safeexambrowser.org/download_en.html" target="_blank"
                                        class="btn btn-outline-secondary w-100 py-2 fw-semibold">
                                        Download SEB Application <i class="fas fa-external-link-alt ms-1 small"></i>
                                    </a>
                                </div>
                            </div>

                            <!-- Footer Note -->
                            <div class="mt-4 pt-3 border-top">
                                <p class="small text-muted mb-0">
                                    Need help? Contact your administrator or check the
                                    <a href="https://safeexambrowser.org/faq/faq_en.html" target="_blank"
                                        class="text-decoration-none">SEB FAQ</a>.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a href="/" class="text-muted text-decoration-none small">
                            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <style>
        .card {
            transition: transform 0.3s ease;
        }

        .btn {
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(43, 108, 176, 0.3);
        }

        .btn-outline-secondary:hover {
            background-color: #f8f9fa;
            color: #6c757d;
            transform: translateY(-1px);
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }
    </style>