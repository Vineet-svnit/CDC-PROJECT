<% layout('/layouts/adminBoilerplate') %>

<%
  const started = hasStarted(test.startTime);
  const readOnlyEdit = started ? 'readonly' : '';
  const disableSelect = started ? 'disabled' : '';
%>

<form method="POST" action="/test/<%= test._id %>?_method=PUT" class="needs-validation" novalidate>

  <!-- ================= Test Meta ================= -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h4 class="fw-bold mb-3">Edit Test</h4>

      <div class="mb-3">
        <label class="form-label">Test Name</label>
        <input
          name="testName"
          value="<%= test.testName %>"
          type="text"
          class="form-control"
          required
          <%= readOnlyEdit %>
        />
      </div>

      <div class="row gx-3 mb-3">
        <div class="col">
          <label class="form-label">Test Date</label>
          <input
            name="date"
            value="<%= getDateInput(test.startTime) %>"
            type="date"
            class="form-control"
            required
            <%= readOnlyEdit %>
          />
        </div>

        <div class="col">
          <label class="form-label">Test Time</label>
          <input
            name="time"
            value="<%= getTimeInput(test.startTime) %>"
            type="time"
            class="form-control"
            required
            <%= readOnlyEdit %>
          />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Duration (minutes)</label>
        <input
          name="duration"
          value="<%= test.duration %>"
          type="number"
          min="1"
          class="form-control"
          required
          <%= readOnlyEdit %>
        />
      </div>

      <div class="mb-3">
        <label class="form-label">Branch</label>
        <select class="form-select" <%= disableSelect %>>
          <option value="lr" <%= test.branch=='lr' ? 'selected' : '' %>>Logical Reasoning</option>
          <option value="ai" <%= test.branch=='ai' ? 'selected' : '' %>>Artificial Intelligence</option>
          <option value="cse" <%= test.branch=='cse' ? 'selected' : '' %>>Computer Science</option>
          <option value="me" <%= test.branch=='me' ? 'selected' : '' %>>Mechanical</option>
        </select>
        <!-- IMPORTANT: disabled select does not submit -->
        <input type="hidden" name="branch" value="<%= test.branch %>">
      </div>

      <div class="mb-3">
        <h5>Categories</h5>
        <ul class="list-group list-group-flush">
          <% test.category.forEach(cat => { %>
            <li class="list-group-item d-flex justify-content-between px-0">
              <%= cat.category_name %>
              <span class="badge bg-primary"><%= cat.numberOfQues %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>

  <!-- ================= Questions ================= -->
  <% for (let i = 0; i < test.numberOfQues; i++) { %>
    <div class="card mb-3">
      <div class="card-body">

        <strong>Question <%= i + 1 %></strong>

        <div class="mb-3">
          <label class="form-label">Question</label>
          <input
            name="questions[<%= i %>][question]"
            value="<%= test.questions[i].question %>"
            class="form-control"
            <%= readOnlyEdit %>
          />
        </div>

        <div class="mb-3">
          <label class="form-label">Type</label>
          <select
            name="questions[<%= i %>][_type]"
            class="form-select"
            <%= disableSelect %>
          >
            <option value="SCQ" <%= test.questions[i]._type==='SCQ' ? 'selected' : '' %>>Single Correct</option>
            <option value="MCQ" <%= test.questions[i]._type==='MCQ' ? 'selected' : '' %>>Multiple Correct</option>
          </select>
        </div>

        <% for (let opt = 1; opt <= 4; opt++) { %>
          <div class="mb-2">
            <label class="form-label">Option <%= opt %></label>
            <input
              name="questions[<%= i %>][option<%= opt %>]"
              value="<%= test.questions[i]['option'+opt] %>"
              class="form-control"
              <%= readOnlyEdit %>
            />
          </div>
        <% } %>

        <div class="mb-3">
          <label class="form-label">Answer</label>
          <input
            name="questions[<%= i %>][answer]"
            value="<%= test.questions[i].answer %>"
            class="form-control"
            required
          />
        </div>

        <input
          type="hidden"
          name="questions[<%= i %>][_id]"
          value="<%= test.questions[i]._id %>"
        />
      </div>
    </div>
  <% } %>

  <div class="text-center mb-5">
    <button class="btn btn-success btn-lg px-5">Update Test</button>
  </div>

</form>

<script src="/js/script.js"></script>
