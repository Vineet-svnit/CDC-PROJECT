<% layout('/layouts/adminBoilerplate') %>

    <style>
        header,
        footer,
        #adminSidebar {
            display: none !important;
        }

        main {
            padding: 0 !important;
        }

        .container-fluid {
            padding: 0 !important;
        }

        .container-lg {
            max-width: 100% !important;
            padding: 0 !important;
        }

        body::before {
            content: "";
            position: fixed;
            top: 55%;
            /* Shifted up slightly from 60% */
            left: 50%;
            transform: translate(-50%, -50%);
            width: 115vw;
            height: 115vh;
            background-image: url('/images/CDC Logo.png');
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            opacity: 0.12;
            z-index: -1;
            pointer-events: none;
        }

        .card {
            background: rgba(255, 255, 255, 0.55) !important;
            backdrop-filter: blur(10px);
            border: none;
        }

        /* Hide validation tick for password fields to avoid overlap with eye icon */
        input[type="password"].form-control {
            background-image: none !important;
        }
    </style>

    <div class="row justify-content-center align-items-center m-0" style="min-height: 100vh;">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm mt-5">
                <div class="card-body">
                    <h3 class="mb-3">Admin Login</h3>
                    <form method="POST" action="/admin/login" class="needs-validation" novalidate>
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" name="adminUserName"
                                placeholder="Enter Admin Username" id="adminUserName" required>
                            <label for="adminUserName">Admin Username</label>
                        </div>
                        <div class="form-floating mb-3 position-relative">
                            <input type="password" class="form-control" name="password" placeholder="Enter Password"
                                id="password" required>
                            <label for="password">Password</label>
                            <button id="btn" type="button" class="btn btn-sm btn-outline-secondary position-absolute"
                                style="right:10px;top:10px;"><i class="fa fa-eye-slash"></i></button>
                        </div>
                        <div class="d-grid">
                            <button class="btn btn-dark" id="login">Login</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script>
        (function () {
            const icon = document.querySelector('#btn i');
            const input = document.querySelector('#password');
            const btn = document.getElementById('btn');
            if (!btn) return;
            btn.addEventListener('click', () => {
                if (icon.classList.contains('fa-eye')) {
                    icon.classList.replace('fa-eye', 'fa-eye-slash'); input.type = 'password';
                } else { icon.classList.replace('fa-eye-slash', 'fa-eye'); input.type = 'text'; }
            });
        })();
    </script>