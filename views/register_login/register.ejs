<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/register_login.css">
<title>Register</title>
</head>

<body>
    <%- include("../includes/flash.ejs") %>
        <div class="circle orange"></div>
        <div class="circle blue"></div>
        <div id="container">
            <h1>Register Here</h1>
            <form method="post" action="/register" class="needs-validation" novalidate>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" name="email" placeholder="Enter Institute Email" id="email"
                        required>
                    <label for="email">Institute email</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="username" placeholder="Username" id="username"
                        readonly>
                    <label for="username">Username</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="program" placeholder="Program" id="program" readonly>
                    <label for="program">Program</label>
                </div>
                <div class="form-floating mb-3 password-wrapper">
                    <input type="password" class="form-control" name="password" placeholder="Enter Password"
                        id="password" required>
                    <label for="password">Password</label><button id="btn" type="button"><i
                            class="fa fa-eye-slash"></i></button>
                </div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="name" placeholder="Enter Full Name" id="name"
                        required>
                    <label for="name">Full name</label>
                </div>
                <select class="form-select form-select-lg mb-3" aria-label="Select branch" id="branch" disabled
                    required>
                    <option value="" disabled selected>Select branch</option>
                </select>
                <input type="hidden" name="branch" id="branchHidden">
                <button class="btn btn-dark mb-3" id="register">Register</button>
                <p>Already have an account? &MediumSpace;<a href="/login">Log in</a>
                </p>
            </form>
        </div>
        <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/js/script.js"></script>
        <script src="/js/register_login.js"></script>
        <script src="/js/constants.js"></script>
        <script>
            // Dynamic branch dropdown based on program detection
            const programInput = document.getElementById('program');
            const branchSelect = document.getElementById('branch');
            const emailInput = document.getElementById('email');
            const usernameInput = document.getElementById('username');

            const programDisplayNames = {
                btech: 'B.Tech',
                mtech: 'M.Tech',
                msc: 'M.Sc',
                mba: 'MBA'
            };

            // Auto-populate username from email and detect program
            emailInput.addEventListener('input', function () {
                const email = this.value.toLowerCase();
                if (email.includes('@')) {
                    const username = email.split('@')[0];
                    usernameInput.value = username;

                    let detectedProgram = '';

                    // Auto-detect program from email pattern
                    if (username.match(/^[ub]\d{2}[a-z]{2}\d{3}$/)) {
                        // B.Tech pattern (u24cs001, b21me002, etc.)
                        detectedProgram = 'btech';
                    } else if (username.match(/^[p]\d{2}[a-z]{2}\d{3}$/)) {
                        // M.Tech pattern (p24co005, etc.)
                        detectedProgram = 'mtech';
                    } else if (username.match(/^[i]\d{2}[a-z]{2}\d{3}$/)) {
                        // M.Sc pattern (i22ph010, etc.)
                        detectedProgram = 'msc';
                    } else if (username.match(/^[m]\d{2}[b][a]\d{3}$/)) {
                        // MBA pattern (m21mg002, etc.)
                        detectedProgram = 'mba';
                    }

                    if (detectedProgram) {
                        programInput.value = programDisplayNames[detectedProgram];
                        const branchCode = username.substring(3, 5);
                        updateBranchOptions(detectedProgram, branchCode);
                    } else {
                        programInput.value = '';
                        updateBranchOptions('', '');
                    }
                } else {
                    usernameInput.value = '';
                    programInput.value = '';
                    updateBranchOptions('', '');
                }
            });

            function updateBranchOptions(program, branchCode) {
                branchSelect.innerHTML = '<option value="" disabled selected>Select branch</option>';

                if (!program || !window.programOptions[program]) {
                    branchSelect.disabled = true;
                    document.getElementById('branchHidden').value = '';
                    return;
                }

                const options = window.programOptions[program];
                let match = null;

                if (branchCode) {
                    const codeMap = {
                        'ai': 'ai', 'ch': 'ch', 'ce': 'ce', 'cs': 'cse', 'co': 'cse',
                        'ep': 'ep', 'ph': 'phy', 'ee': 'ee', 'ec': 'ece', 'el': 'ece',
                        'ic': 'ic', 'cy': 'chem', 'mn': 'mnc', 'ma': 'math', 'me': 'me',
                        'vl': 'vlsi', 'ba': 'ba', 'mg': 'ba'
                    };
                    const mappedCode = codeMap[branchCode] || branchCode;

                    let prefix = program === 'btech' ? 'b_' :
                        program === 'mtech' ? 'm_' :
                            program === 'msc' ? 'msc_' : 'mba_';

                    // Specifically math for btech is called 'mnc' but for msc is 'math' so mapping helps
                    if (program === 'btech' && mappedCode === 'math') match = options.find(opt => opt.value === 'b_mnc');
                    else match = options.find(opt => opt.value === (prefix + mappedCode)) || options.find(opt => opt.value === mappedCode);
                }

                if (match) {
                    const opt = document.createElement('option');
                    opt.value = match.value;
                    opt.textContent = match.text;
                    opt.selected = true;
                    branchSelect.appendChild(opt);

                    branchSelect.disabled = true;
                    document.getElementById('branchHidden').value = match.value;
                } else {
                    // Fallback to manual selection
                    options.forEach(option => {
                        const opt = document.createElement('option');
                        opt.value = option.value;
                        opt.textContent = option.text;
                        branchSelect.appendChild(opt);
                    });
                    branchSelect.disabled = false;
                    document.getElementById('branchHidden').value = '';
                }
            }

            // Initially disable branch select
            branchSelect.disabled = true;

            // Important: sync manual selection to hidden field
            branchSelect.addEventListener('change', function () {
                document.getElementById('branchHidden').value = this.value;
            });

            document.querySelector('form').addEventListener('submit', function (e) {
                if (!document.getElementById('branchHidden').value) {
                    e.preventDefault();
                    alert("Invalid email or branch");
                }
            });
        </script>
</body>

</html>