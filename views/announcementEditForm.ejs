<% layout('/layouts/adminBoilerplate') %>

<div class="admin-form-container">
  <div class="admin-form-card">
    <div class="admin-form-header edit-form">
      <h4>Edit Announcement</h4>
    </div>
    <div class="admin-form-body">
      <form method="POST" action="/announcement/<%= id %>?_method=PUT" class="needs-validation" novalidate>
        <div class="mb-4">
          <label for="title" class="form-label">Title</label>
          <input name="title" value="<%= announcement.title %>" placeholder="Enter announcement title" type="text" id="title" class="form-control" required/>
        </div>
        
        <div class="mb-4">
          <label for="body" class="form-label">Message</label>
          <div id="editor" style="height: 200px;"></div>
          <input type="hidden" value="<%= announcement.body %>" name="body" id="body" class="form-control" required>
          <div class="invalid-feedback">Message is required.</div>
        </div>
        
        <div class="mb-4">
          <label for="issued_by" class="form-label">Issued by</label>
          <input name="issued_by" value="<%= announcement.issued_by %>" placeholder="Enter the issuer name" type="text" id="issued_by" class="form-control" required/>
        </div>

        <hr class="my-4">
        <h6 class="mb-3">Target Audience (Optional - Leave as "All" for everyone)</h6>
        
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label for="program" class="form-label">Program</label>
            <select class="form-select" id="program" name="program">
              <option value="all" <%= announcement.program === 'all' ? 'selected' : '' %>>All Programs</option>
              <option value="btech" <%= announcement.program === 'btech' ? 'selected' : '' %>>B.Tech</option>
              <option value="mtech" <%= announcement.program === 'mtech' ? 'selected' : '' %>>M.Tech</option>
              <option value="mba" <%= announcement.program === 'mba' ? 'selected' : '' %>>MBA</option>
              <option value="msc" <%= announcement.program === 'msc' ? 'selected' : '' %>>M.Sc</option>
            </select>
          </div>
          <div class="col-md-4">
            <label for="branch" class="form-label">Branch</label>
            <select class="form-select" id="branch" name="branch">
              <option value="all">All Branches</option>
            </select>
          </div>
          <div class="col-md-4">
            <label for="year" class="form-label">Admission Year</label>
            <input type="number" class="form-control" id="year" name="year" placeholder="All years (leave empty)" value="<%= announcement.year || '' %>">
          </div>
        </div>
        
        <div class="text-center">
          <button class="btn btn-primary btn-lg px-5">
            <i class="fas fa-save"></i> Update Announcement
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
  const quill = new Quill('#editor', { 
    theme: 'snow', 
    placeholder: 'Write your announcement here...',
    modules: { 
      toolbar: [
        ['bold','italic','underline'], 
        [{ 'list': 'ordered' }, { 'list': 'bullet' }], 
        ['link']
      ] 
    } 
  });
  
  quill.root.innerHTML = document.querySelector('#body').value || '';
  
  document.querySelector('form').addEventListener('submit', function (event) {
    const content = quill.root.innerHTML.trim();
    const isEmpty = content === '' || content === '<p><br></p>';
    document.querySelector('#body').value = content;
    
    if (isEmpty) { 
      event.preventDefault(); 
      event.stopPropagation(); 
      document.querySelector('#body').classList.add('is-invalid'); 
    } else { 
      document.querySelector('#body').classList.remove('is-invalid'); 
    }
  });

  // Branch options based on program
  const branchOptions = {
    btech: [
      { value: 'ai', text: 'Artificial Intelligence' },
      { value: 'ch', text: 'Chemical' },
      { value: 'ic', text: 'Chemistry' },
      { value: 'ce', text: 'Civil Engineering' },
      { value: 'cs', text: 'Computer Science and Engineering' },
      { value: 'ee', text: 'Electrical Engineering' },
      { value: 'ee', text: 'Electronics Engineering' },
      { value: 'hs', text: 'Humanities and Social Sciences' },
      { value: 'ms', text: 'Management Studies' },
      { value: 'ma', text: 'Mathematics' },
      { value: 'me', text: 'Mechanical Engineering' },
      { value: 'ep', text: 'Physics' }
    ],
    mtech: [
      { value: 'ai', text: 'Artificial Intelligence' },
      { value: 'ch', text: 'Chemical' },
      { value: 'ic', text: 'Chemistry' },
      { value: 'ce', text: 'Civil Engineering' },
      { value: 'cs', text: 'Computer Science and Engineering' },
      { value: 'ee', text: 'Electrical Engineering' },
      { value: 'ee', text: 'Electronics Engineering' },
      { value: 'hs', text: 'Humanities and Social Sciences' },
      { value: 'ms', text: 'Management Studies' },
      { value: 'ma', text: 'Mathematics' },
      { value: 'me', text: 'Mechanical Engineering' },
      { value: 'ep', text: 'Physics' }
    ],
    msc: [
      { value: 'ep', text: 'Physics' },
      { value: 'ic', text: 'Chemistry' },
      { value: 'ma', text: 'Mathematics' }
    ],
    mba: [
      { value: '', text: 'Business Analytics' }
    ]
  };

  const programSelect = document.getElementById('program');
  const branchSelect = document.getElementById('branch');
  const currentBranch = '<%= announcement.branch || "all" %>';

  function updateBranchOptions() {
    const selectedProgram = programSelect.value;
    branchSelect.innerHTML = '<option value="all">All Branches</option>';
    
    if (selectedProgram !== 'all' && branchOptions[selectedProgram]) {
      branchOptions[selectedProgram].forEach(option => {
        const opt = document.createElement('option');
        opt.value = option.value;
        opt.textContent = option.text;
        if (option.value === currentBranch) {
          opt.selected = true;
        }
        branchSelect.appendChild(opt);
      });
      branchSelect.disabled = false;
    } else {
      branchSelect.disabled = true;
      if (currentBranch === 'all') {
        branchSelect.value = 'all';
      }
    }
  }

  programSelect.addEventListener('change', updateBranchOptions);
  
  // Initialize on page load
  updateBranchOptions();
</script>