<% layout('/layouts/adminBoilerplate') %>

<div class="card shadow-sm">
  <div class="card-body">
    <h4 class="fw-bold mb-3">Edit Announcement</h4>
    <form method="POST" action="/announcement/<%= id %>?_method=PUT" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="title" value="<%= announcement.title %>" placeholder="Enter title" type="text" id="title" class="form-control" required/>
      </div>
      <div class="mb-3">
        <label for="body" class="form-label">Message</label>
        <div id="editor" style="height: 200px;"></div>
        <input type="hidden" value="<%= announcement.body %>" name="body" id="body" class="form-control" required>
        <div class="invalid-feedback">Message is required.</div>
      </div>
      <div class="mb-3">
        <label for="issued_by" class="form-label">Issued by</label>
        <input name="issued_by" value="<%= announcement.issued_by %>" placeholder="Enter the issuer" type="text" id="issued_by" class="form-control" required/>
      </div>
      <div class="d-grid">
        <button class="btn btn-primary">Update</button>
      </div>
    </form>
  </div>
</div>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
  const quill = new Quill('#editor', { theme: 'snow', modules: { toolbar: [['bold','italic','underline'], [{ 'list': 'ordered' }, { 'list': 'bullet' }], ['link']] } });
  quill.root.innerHTML = document.querySelector('#body').value || '';
  document.querySelector('form').addEventListener('submit', function (event) {
    const content = quill.root.innerHTML.trim();
    const isEmpty = content === '' || content === '<p><br></p>';
    document.querySelector('#body').value = content;
    if (isEmpty) { event.preventDefault(); event.stopPropagation(); document.querySelector('#body').classList.add('is-invalid'); }
    else { document.querySelector('#body').classList.remove('is-invalid'); }
  });
</script>