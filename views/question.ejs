<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= test.testName %> - Exam
    </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/global.css">
    <link href="/css/question.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body style="background-color: #f5f7fa; overflow-x: hidden;">

    <!-- Submission Loading Overlay -->
    <div id="submissionOverlay" class="submission-overlay">
        <div class="submission-spinner"></div>
        <div class="submission-overlay-text">Submitting your test...</div>
        <div class="submission-overlay-subtext">Please wait while we calculate your score</div>
    </div>

    <!-- Instruction Overlay (shown during buffer period) -->
    <div id="instructionOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.95); z-index: 9999; overflow-y: auto;">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card shadow-lg border-0" style="background: #ffffff;">
                        <div class="card-header bg-primary text-white text-center py-4">
                            <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Test Instructions</h3>
                            <p class="mb-0 mt-2">Please read carefully before starting</p>
                        </div>
                        <div class="card-body p-5">
                            <div class="alert alert-info mb-4">
                                <i class="fas fa-clock me-2"></i>
                                <strong>Test will begin in: <span id="bufferTimer" class="fs-5">00:00</span></strong>
                            </div>

                            <h5 class="text-primary mb-3"><i class="fas fa-clipboard-list me-2"></i>General Instructions</h5>
                            <ul class="list-unstyled mb-4">
                                <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>This is a timed examination. The timer will start automatically when the test begins.</li>
                                <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>Total Duration: <strong><%= test.duration %> minutes</strong></li>
                                <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>Total Questions: <strong><%= test.questions.length %></strong></li>
                                <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>Total Marks: <strong><%= test.totalMarks %></strong></li>
                            </ul>

                            <h5 class="text-primary mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Important Rules</h5>
                            <ul class="list-unstyled mb-4">
                                <li class="mb-3"><i class="fas fa-times-circle text-danger me-2"></i><strong>No cheating or malpractice</strong> - Any form of cheating will result in disqualification</li>
                                <li class="mb-3"><i class="fas fa-times-circle text-danger me-2"></i><strong>Do not switch tabs or windows</strong> - Your test will be auto-submitted if you leave this page</li>
                                <li class="mb-3"><i class="fas fa-times-circle text-danger me-2"></i><strong>Do not use browser back button</strong> - This will submit your test automatically</li>
                                <li class="mb-3"><i class="fas fa-times-circle text-danger me-2"></i><strong>Do not refresh the page</strong> - Your progress is saved automatically</li>
                                <li class="mb-3"><i class="fas fa-times-circle text-danger me-2"></i><strong>Ensure stable internet connection</strong> - Connection issues may affect submission</li>
                            </ul>

                            <h5 class="text-primary mb-3"><i class="fas fa-lightbulb me-2"></i>Exam Features</h5>
                            <ul class="list-unstyled mb-4">
                                <li class="mb-3"><i class="fas fa-arrow-right text-info me-2"></i>You can navigate between questions using Next/Previous buttons</li>
                                <li class="mb-3"><i class="fas fa-arrow-right text-info me-2"></i>Use "Mark for Review" to flag questions you want to revisit</li>
                                <li class="mb-3"><i class="fas fa-arrow-right text-info me-2"></i>Use "Clear" to remove your answer for the current question</li>
                                <li class="mb-3"><i class="fas fa-arrow-right text-info me-2"></i>Question Navigator shows your progress at a glance</li>
                                <li class="mb-3"><i class="fas fa-arrow-right text-info me-2"></i>The test will auto-submit when time expires</li>
                            </ul>

                            <div class="alert alert-warning mb-4">
                                <i class="fas fa-hourglass-half me-2"></i>
                                <strong>Please wait...</strong> The test will start automatically at the scheduled time. Do not close this window.
                            </div>
                            
                            <div class="text-center" style="width: 100%; display: flex; justify-content: center;">
                                <a href="/randomquit" id="exitExamBtnOverlay" class="btn btn-danger" style="display: none; width: auto;">
                                    <i class="fas fa-door-open me-2"></i>Exit Exam Mode
                                </a>
                            </div>

                            <script>
                                (function () {
                                    const btn = document.getElementById("exitExamBtnOverlay");
                                    if (!btn) return;
                                    const ua = navigator.userAgent || "";
                                    const isSEB = ua.includes("SEB") || ua.includes("SafeExamBrowser");
                                    if (isSEB) {
                                        btn.style.display = "inline-block";
                                    }
                                })();
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-md-5 py-4" style="min-height: 100vh;">

        <!-- Header -->
        <div class="exam-header d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-0 text-primary">
                    <%= test.testName %>
                </h4>
                <span class="text-muted small">Academic Examination Portal</span>
            </div>
            <div class="timer-pill" id="timer-container">
                <i class="fas fa-clock"></i>
                <span id="timer">00:00:00</span>
            </div>
        </div>

        <div class="row grow g-4">

            <!-- Main Content (Question Area) -->
            <div class="col-lg-8">
                <div class="exam-card h-100 d-flex flex-column p-4">

                    <!-- Instructions -->
                    <div id="instruction" class="mb-4" style="display: none;"></div>

                    <!-- Question Content -->
                    <div class="mb-auto">
                        <div class="question-number">Question <span id="quesNum">1</span></div>
                        <div class="question-text ques mb-4"></div>

                        <!-- Options Wrap -->
                        <div class="options-wrap options mb-5">
                            <!-- Options injected by JS -->
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex flex-wrap gap-3 pt-4 border-top">
                        <button id="clear" class="btn-action">
                            <i class="fas fa-eraser"></i> Clear
                        </button>
                        <button id="mark" class="btn-action">
                            <i class="fas fa-bookmark"></i> Mark for Review
                        </button>
                        <div class="ms-auto d-flex gap-2">
                            <button id="prev" class="btn-action">
                                <i class="fas fa-chevron-left"></i> Previous
                            </button>
                            <button id="next" class="btn-action">
                                Next <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar (Palette & Stats) -->
            <div class="col-lg-4">
                <div class="exam-card p-4 position-sticky" style="top: 2rem;">

                    <!-- Stats Section -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">Live Statistics</h6>
                        <div class="stat-pill">
                            <span class="stat-label"><i class="fas fa-check-circle text-success"></i> Attempted</span>
                            <span class="stat-value at text-success">0</span>
                        </div>
                        <div class="stat-pill">
                            <span class="stat-label"><i class="fas fa-circle text-muted"></i> Unattempted</span>
                            <span class="stat-value unat text-muted">
                                <%= test.questions.length %>
                            </span>
                        </div>
                        <div class="stat-pill">
                            <span class="stat-label"><i class="fas fa-flag text-primary"></i> Marked</span>
                            <span class="stat-value marked-val text-primary">0</span>
                        </div>
                    </div>

                    <hr class="my-4 opacity-10">

                    <!-- Palette -->
                    <h6 class="fw-bold mb-3">Question Navigator</h6>
                    <div id="pallete">
                        <!-- Palette items injected by JS -->
                    </div>

                    <div class="mt-5 pt-2">
                        <button id="submit" class="btn-action">
                            <i class="fas fa-paper-plane me-2"></i> COMPLETE & SUBMIT TEST
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        // Times are already in UTC from server, convert to local time for timer
        const startTime = new Date("<%= test.startTime.toISOString() %>");
        const endTime = new Date("<%= test.endTime.toISOString() %>");
        // Compute offset between server time and client time once
        const serverNow = new Date("<%= new Date().toISOString() %>");
        const clientNow = new Date();
        const timeOffset = serverNow - clientNow; // positive if client behind server
        let testHasStarted = false;
        let timerInterval = null;

        // Check if we're in buffer period
        function checkBufferPeriod() {
            const now = new Date(Date.now() + timeOffset);
            const timeUntilStart = startTime - now;
            
            if (timeUntilStart > 0) {
                // We're in buffer period - show instructions
                document.getElementById('instructionOverlay').style.display = 'block';
                updateBufferTimer();
                return true;
            } else {
                // Test has started - hide instructions
                document.getElementById('instructionOverlay').style.display = 'none';
                if (!testHasStarted) {
                    testHasStarted = true;
                    startTestTimer();
                }
                return false;
            }
        }

        // Update buffer timer countdown
        function updateBufferTimer() {
            const now = new Date(Date.now() + timeOffset);
            const timeUntilStart = startTime - now;
            
            if (timeUntilStart <= 0) {
                // Test is starting now
                document.getElementById('instructionOverlay').style.display = 'none';
                if (!testHasStarted) {
                    testHasStarted = true;
                    startTestTimer();
                }
                return;
            }
            
            const minutes = Math.floor(timeUntilStart / (1000 * 60));
            const seconds = Math.floor((timeUntilStart % (1000 * 60)) / 1000);
            
            document.getElementById('bufferTimer').innerText = 
                `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            
            setTimeout(updateBufferTimer, 1000);
        }

        // Start the actual test timer
        function startTestTimer() {
            updateTimer();
            timerInterval = setInterval(updateTimer, 1000);
        }

        function updateTimer() {
            const now = new Date(Date.now() + timeOffset);
            const timeLeft = endTime - now;

            if (timeLeft <= 0) {
                // Optionally submit the form automatically
                if (timerInterval) clearInterval(timerInterval);
                legalSubmission = true;
                document.querySelector('#submit').click();
                return;
            }

            const hours = Math.floor(timeLeft / (1000 * 60 * 60));
            const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

            document.getElementById("timer").innerText =
                `${hours.toString().padStart(2, '0')}:${minutes
                    .toString().padStart(2, '0')}:${seconds
                        .toString().padStart(2, '0')}`;
        }

        // Initialize on page load
        checkBufferPeriod();

        let questions = <%- JSON.stringify(test.questions) %>; // do not touch this line
        let submissions = [];
    </script>
    <script>
        const testId = "<%= test._id %>";
        const userId = "<%= user_id %>";
        let legalSubmission = false;
        let isReloading = false;

        // =============================
        // 1) Before unload → mark reload and store in localStorage
        // =============================
        window.addEventListener("beforeunload", () => {
            isReloading = true;
            // Save current state of submissions + questions to localStorage
            console.log('sadly i was triggered');

            localStorage.setItem(`questions_${testId}`, JSON.stringify(questions));
            localStorage.setItem(`submissions_${testId}`, JSON.stringify(submissions));
        });

        document.querySelector("#submit").addEventListener("mousedown", () => {
            legalSubmission = true;
        })

        document.querySelector("#submit").addEventListener("click", async (e) => {
            // Show loading overlay immediately
            document.getElementById('submissionOverlay').classList.add('active');

            try {
                // await axios.post(`/submission/${testId}`, { submissions, questions });
                await axios.post(`/submission/${testId}`, { submissions });
                legalSubmission = true;
                localStorage.clear();
                window.location.href = `/submission/${testId}`;
                // Overlay stays visible until the browser navigates away
            } catch (err) {
                // Hide overlay on error so user can retry
                document.getElementById('submissionOverlay').classList.remove('active');
                console.error('Submission failed:', err);
                alert('Submission failed. Please try again.');
            }
        });

        // document.addEventListener("visibilitychange", async () => {
        //     if (document.visibilityState === 'hidden' && !legalSubmission) {
        //         document.querySelector('#submit').click();
        //         // await axios.post(`/submission/${testId}`, { submissions });
        //         // window.location.href = `/submission/${testId}`;
        //     }
        // });
        document.addEventListener("visibilitychange", async () => {
            setTimeout(async () => {
                if (document.visibilityState === 'hidden' && !legalSubmission) {
                    if (isReloading) {
                        // Ignore tab close if it was just a reload
                        isReloading = false;
                        return;
                    }
                    // Force submit if tab was closed/switched
                    document.querySelector('#submit').click();
                }
            }, 500); // small delay lets isReloading update first
        });
        history.pushState(null, null, location.href);
        window.onpopstate = function () {
            history.pushState(null, null, location.href);
            document.querySelector('#submit').click();
        };

        let storedQuestions = localStorage.getItem(`questions_${testId}`);
        let storedSubmissions = localStorage.getItem(`submissions_${testId}`);

        if (storedQuestions !== null && storedSubmissions !== null) {
            // Reload case → use saved data
            questions = JSON.parse(storedQuestions);
            submissions = JSON.parse(storedSubmissions);
            // display(0);
        } else {
            // First load → shuffle questions
            localStorage.clear();
            function shuffle(questions) {
                for (let i = questions.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [questions[i], questions[j]] = [questions[j], questions[i]];
                }
                return questions;
            }
            questions = shuffle(questions);

            // Initialize submissions array
            submissions = Array(questions.length).fill().map(() => ({
                answer: "",
                isMarked: false
            }));
        }

    </script>
    <script src="/js/question.js"></script>

    <!-- Enforce full screen -->
    <!-- Detect tab switching -->

    <script>
        count_atm_unatm_mark();
        for (let i = 0; i < questions.length; i++) {
            submissions[i].question = questions[i]._id;
        }
    </script>
    <script type="module">
        //     import 'url-change-event';

        //     window.addEventListener('urlchangeevent', (e) => {
        //       console.log('URL changed:', e.detail);
        //     });
        //   </script>

    <script>
        document.addEventListener("contextmenu", e => e.preventDefault());
        document.onkeydown = function (e) {
            if (
                e.keyCode == 123 || // F12
                (e.ctrlKey && e.shiftKey && (e.keyCode == 73 || e.keyCode == 74)) || // Ctrl+Shift+I/J
                (e.ctrlKey && e.keyCode == 85) // Ctrl+U
            ) {
                return false;
            }
        };
    </script>

</body>

</html>