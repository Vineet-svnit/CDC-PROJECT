<% layout('/layouts/adminBoilerplate') %>

    <div class="admin-form-container">
        <div class="admin-form-card">
            <div class="admin-form-header test-form">
                <h4>Create Test</h4>
            </div>
            <div class="admin-form-body">
                <form method="POST" action="/test/questions/new" class="needs-validation" novalidate>
                    <div class="mb-4">
                        <label for="testName" class="form-label">Test Name</label>
                        <input name="testName" placeholder="Enter name of the test" type="text" id="testName"
                            class="form-control" required />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label for="date" class="form-label">Test Date</label>
                            <input name="date" placeholder="Enter date of test" type="date" id="date"
                                class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label for="time" class="form-label">Test Timing</label>
                            <input name="time" placeholder="Enter time for the test" type="time" id="time"
                                class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label for="totalCutoffPercentage" class="form-label">Total Cutoff (%)</label>
                            <input name="totalCutoffPercentage" placeholder="Enter total cutoff %" type="number"
                                id="totalCutoffPercentage" class="form-control" min="0" max="100" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label for="duration" class="form-label">Duration (minutes)</label>
                            <input name="duration" placeholder="Enter duration" type="number" id="duration"
                                class="form-control" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="program" class="form-label">Program</label>
                            <select class="form-select" id="program" name="program" required>
                                <option value="" disabled selected>Select program</option>
                                <option value="btech">B.Tech</option>
                                <option value="mtech">M.Tech</option>
                                <option value="mba">MBA</option>
                                <option value="msc">M.Sc</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="year" class="form-label">Admission Year</label>
                            <input type="number" class="form-control" id="year" name="year" placeholder="e.g. 2024"
                                min="2000" max="2100" required>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label d-block">Test Type</label>
                            <div class="form-check form-check-inline mt-2">
                                <input class="form-check-input" type="radio" name="isTechnical" id="typeTech"
                                    value="true" checked>
                                <label class="form-check-label" for="typeTech">Technical</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="isTechnical" id="typeNonTech"
                                    value="false">
                                <label class="form-check-label" for="typeNonTech">Non-Technical</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="branch" class="form-label">Select Branch</label>
                            <select class="form-select" id="branch" name="branch" required disabled>
                                <option value="" disabled selected>Select branch</option>
                            </select>
                        </div>
                    </div>

                    <div id="categories-section" style="display:none;">
                        <h5>Categories</h5>
                        <div id="categories-container" class="mb-3"></div>
                        <button type="button" class="btn btn-outline-primary" id="add-category-btn">
                            <i class="fas fa-plus"></i> Add Category
                        </button>
                    </div>

                    <div class="text-center mt-4">
                        <button class="btn btn-primary btn-lg px-5">
                            <i class="fas fa-save"></i> Create Test
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Dynamic branch dropdown based on program selection
        const programSelect = document.getElementById('program');
        const branchSelect = document.getElementById('branch');

        const branchOptions = {
            btech: [
                { value: 'ai', text: 'Artificial Intelligence' },
                { value: 'che', text: 'Chemical' },
                { value: 'chm', text: 'Chemistry' },
                { value: 'ce', text: 'Civil Engineering' },
                { value: 'cse', text: 'Computer Science and Engineering' },
                { value: 'ee', text: 'Electrical Engineering' },
                { value: 'ece', text: 'Electronics Engineering' },
                { value: 'hss', text: 'Humanities and Social Sciences' },
                { value: 'ms', text: 'Management Studies' },
                { value: 'math', text: 'Mathematics' },
                { value: 'me', text: 'Mechanical Engineering' },
                { value: 'phy', text: 'Physics' }
            ],
            mtech: [
                { value: 'ai', text: 'Artificial Intelligence' },
                { value: 'che', text: 'Chemical' },
                { value: 'chm', text: 'Chemistry' },
                { value: 'ce', text: 'Civil Engineering' },
                { value: 'cse', text: 'Computer Science and Engineering' },
                { value: 'ee', text: 'Electrical Engineering' },
                { value: 'ece', text: 'Electronics Engineering' },
                { value: 'hss', text: 'Humanities and Social Sciences' },
                { value: 'ms', text: 'Management Studies' },
                { value: 'math', text: 'Mathematics' },
                { value: 'me', text: 'Mechanical Engineering' },
                { value: 'phy', text: 'Physics' }
            ],
            msc: [
                { value: 'phy', text: 'Physics' },
                { value: 'chm', text: 'Chemistry' },
                { value: 'math', text: 'Mathematics' }
            ],
            mba: [
                { value: '', text: 'No branch required' }
            ]
        };

        if (programSelect && branchSelect) {
            programSelect.addEventListener('change', function () {
                const selectedProgram = this.value;
                branchSelect.innerHTML = '<option value="" disabled selected>Select branch</option>';

                if (selectedProgram && branchOptions[selectedProgram]) {

                    branchOptions[selectedProgram].forEach(option => {
                        const opt = document.createElement('option');
                        opt.value = option.value;
                        opt.textContent = option.text;
                        branchSelect.appendChild(opt);
                    });
                    branchSelect.disabled = false;
                } else {
                    branchSelect.disabled = true;
                }
            });
        }

        let availableCategories = [];
        const branchEl = document.getElementById('branch');
        if (branchEl) branchEl.addEventListener('change', async function () {
            const branch = this.value;
            const res = await fetch(`/categories/${branch}`);
            availableCategories = await res.json();
            document.getElementById('categories-section').style.display = 'block';
            document.getElementById('categories-container').innerHTML = '';
            addCategoryRow();
        });
        const addBtn = document.getElementById('add-category-btn');
        if (addBtn) addBtn.addEventListener('click', addCategoryRow);

        function addCategoryRow() {
            const container = document.getElementById('categories-container');
            const row = document.createElement('div');
            row.className = 'row category-row align-items-end';
            let options = availableCategories.map(cat => `<option value="${cat.category}" data-count="${cat.count}">${cat.category} (${cat.count} questions)</option>`).join('');
            row.innerHTML = `
            <div class="col-md-5">
                <label class="form-label">Category</label>
                <select name="category_name" class="form-select category-select" required>
                    <option value="" disabled selected>Select category</option>
                    ${options}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Question Count</label>
                <input name="catNumberOfQues" type="number" class="form-control question-count" min="1" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Cutoff (%)</label>
                <input name="catCutoffPercentage" type="number" class="form-control cutoff-input" min="0" max="100" placeholder="0-100" required />
            </div>
            <div class="col-md-1 text-center">
                <button type="button" class="remove-row">
                    <i class="fas fa-trash"></i>
                </button>
            </div>`;
            container.appendChild(row);

            // Add event listeners
            row.querySelector('.remove-row').addEventListener('click', () => row.remove());

            const categorySelect = row.querySelector('.category-select');
            const countInput = row.querySelector('.question-count');
            const feedback = row.querySelector('.invalid-feedback');

            // Validate question count when category changes or count is entered
            function validateCount() {
                const selectedOption = categorySelect.selectedOptions[0];
                if (selectedOption && countInput.value) {
                    const availableCount = parseInt(selectedOption.dataset.count);
                    const requestedCount = parseInt(countInput.value);

                    if (requestedCount > availableCount) {
                        countInput.classList.add('is-invalid');
                        feedback.textContent = `Only ${availableCount} questions available in this category`;
                        return false;
                    } else {
                        countInput.classList.remove('is-invalid');
                        feedback.textContent = '';
                        return true;
                    }
                }
                return true;
            }

            categorySelect.addEventListener('change', validateCount);
            countInput.addEventListener('input', validateCount);
        }

        // Form validation before submission
        document.querySelector('form').addEventListener('submit', function (e) {
            let isValid = true;
            const categoryRows = document.querySelectorAll('.category-row');

            categoryRows.forEach(row => {
                const categorySelect = row.querySelector('.category-select');
                const countInput = row.querySelector('.question-count');
                const selectedOption = categorySelect.selectedOptions[0];

                if (selectedOption && countInput.value) {
                    const availableCount = parseInt(selectedOption.dataset.count);
                    const requestedCount = parseInt(countInput.value);

                    if (requestedCount > availableCount) {
                        isValid = false;
                        countInput.classList.add('is-invalid');
                        row.querySelector('.invalid-feedback').textContent = `Only ${availableCount} questions available in this category`;
                    }
                }
            });

            if (!isValid) {
                e.preventDefault();
                alert('Please fix the validation errors before submitting.');
            }
        });
    </script>