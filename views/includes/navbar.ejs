    </a>

    <!-- Toggle for mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation Items -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-1">
        <li class="nav-item">
          <a class="nav-link fw-500 <%= currentPath === '/' ? 'active border-bottom border-primary' : '' %>" href="/"
            style="color: #0f172a;">
            <i class="fas fa-brain me-1"></i>Aptitude
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-500 <%= currentPath === '/core' ? 'active border-bottom border-primary' : '' %>"
            href="/core" style="color: #0f172a;">
            <i class="fas fa-book me-1"></i>Core Subject
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-500 <%= currentPath === '/history' ? 'active border-bottom border-primary' : '' %>"
            href="/history" style="color: #0f172a;">
            <i class="fas fa-history me-1"></i>History
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-500 <%= currentPath === '/announcement' ? 'active border-bottom border-primary' : '' %>"
            href="/announcement" style="color: #0f172a;">
            <i class="fas fa-bell me-1"></i>Announcements
          </a>
        </li>


        <!-- User menu with dropdown -->
        <li class="nav-item dropdown ms-2">
          <a class="nav-link dropdown-toggle fw-500" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
            <i class="fas fa-user-circle me-1"></i>
            <%= currentUser ? currentUser.username : (typeof isAdmin !=='undefined' && isAdmin ? 'Admin' : 'Guest' ) %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
