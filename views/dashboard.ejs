<% layout("/layouts/adminBoilerplate") %>

<div class="py-5">
  <div class="container-lg">
    <div class="d-flex align-items-center mb-4">
      <div style="width:4px;height:40px;background:#27496d;border-radius:2px;margin-right:12px"></div>
      <h1 class="h4 mb-0 fw-bold" style="color:#27496d">Admin Dashboard</h1>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card border-0 text-center p-4" style="background: linear-gradient(135deg,#e0f2fe 0%,#e0e7ff 100%)">
          <h6 class="text-muted mb-1">Total Students</h6>
          <h3 class="fw-bold mb-0" id="totalStudents">--</h3>
          <div class="text-muted small">Registered Users</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 text-center p-4" style="background: linear-gradient(135deg,#d1fae5 0%,#bbf7d0 100%)">
          <h6 class="text-muted mb-1">Active Tests</h6>
          <h3 class="fw-bold mb-0" id="activeTests">--</h3>
          <div class="text-muted small">Ongoing right now</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 text-center p-4" style="background: linear-gradient(135deg,#fff7ed 0%,#fde68a 100%)">
          <h6 class="text-muted mb-1">Completed Tests</h6>
          <h3 class="fw-bold mb-0" id="completedTests">--</h3>
          <div class="text-muted small">Already finished</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 text-center p-4" style="background: linear-gradient(135deg,#fff1f2 0%,#fee2e2 100%)">
          <h6 class="text-muted mb-1">Upcoming Tests</h6>
          <h3 class="fw-bold mb-0" id="upcomingTests">--</h3>
          <div class="text-muted small">Starting soon</div>
        </div>
      </div>
    </div>

    <!-- Announcements & Tests -->
    <div class="row mb-4">
      <div class="col-lg-6 mb-4">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white border-bottom d-flex align-items-center">
            <h5 class="mb-0 fw-bold" style="color:#27496d">Announcements</h5>
            <a href="/announcement/new" class="btn btn-primary btn-sm ms-auto">New Announcement</a>
          </div>
          <div class="card-body">
            <% if (allAnnouncements && allAnnouncements.length > 0) { %>
              <% for (let ai = 0; ai < allAnnouncements.length; ai++) { const announcement = allAnnouncements[ai]; %>
                <div class="mb-3 announcement-item" data-index="<%= ai %>">
                  <div class="fw-semibold"><%= announcement.title %></div>
                  <div class="text-muted small">Date: <%= announcement.date %></div>
                  <div class="mt-2"><%- announcement.body %></div>
                  <div class="mt-2 text-end">
                    <a href="/announcement/<%= announcement._id %>" class="btn btn-sm btn-warning">Edit</a>
                    <form action="/announcement/<%= announcement._id %>?_method=DELETE" method="POST" style="display:inline">
                      <button class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </div>
                <hr>
              <% } %>
            <% } else { %>
              <p class="text-muted">No announcements yet</p>
            <% } %>
          </div>
          <% if (allAnnouncements && allAnnouncements.length > 4) { %>
            <div class="card-footer bg-white text-center">
              <button id="toggleAnnouncementsBtn" class="btn btn-sm btn-outline-primary">Show All Announcements</button>
            </div>
          <% } %>
          <div class="card-footer bg-white">
            <form action="/download" method="POST" class="row g-3 align-items-center">
              <div class="col-md-5">
                <label for="branch_name" class="form-label">Select Branch</label>
                <select class="form-select" id="branch_name" name="branch_name" required>
                  <option value="" disabled selected>Select branch</option>
                  <option value="lr">Logical Reasoning and Aptitude</option>
                  <option value="ai">Artificial Intelligence</option>
                  <option value="che">Chemical Engineering</option>
                  <option value="chm">Chemistry</option>
                  <option value="ce">Civil Engineering</option>
                  <option value="cse">Computer Science and Engineering</option>
                  <option value="ee">Electrical Engineering</option>
                  <option value="ece">Electronics Engineering</option>
                  <option value="hss">Humanities and Social Sciences</option>
                  <option value="ms">Management Studies</option>
                  <option value="math">Mathematics</option>
                  <option value="me">Mechanical Engineering</option>
                  <option value="phy">Physics</option>
                </select>
              </div>
              <div class="col-md-5">
                <label for="test_id" class="form-label">Select Test</label>
                <select class="form-select" id="test_id" name="test_id" required>
                </select>
              </div>
              <div class="col-12">
                <div class="d-grid mt-2">
                  <button type="submit" class="btn btn-success w-100">Download Result</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-6 mb-4">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white border-bottom d-flex align-items-center">
            <h5 class="mb-0 fw-bold" style="color:#27496d">Tests</h5>
            <a href="/test/new" class="btn btn-primary btn-sm ms-auto">New Test</a>
          </div>
          <div class="card-body">
            <div id="testsList">
              <% if (allTests && allTests.length > 0) { %>
                <% for (let ti = 0; ti < allTests.length; ti++) { const test = allTests[ti]; %>
                  <div class="mb-3 test-item" data-index="<%= ti %>">
                    <div class="fw-semibold"><%= test.testName %></div>
                    <div class="text-muted small">Scheduled: <%= formatDate(test.startTime) %> <%= formatTime(test.startTime) %></div>
                    <div class="mt-2">Questions: <%= test.numberOfQues %> • Marks: <%= test.totalMarks %></div>
                    <div class="mt-2 text-end">
                      <a href="/test/<%= test._id %>" class="btn btn-sm btn-warning">Edit</a>
                      <form action="/test/<%= test._id %>?_method=DELETE" method="POST" style="display:inline">
                        <button class="btn btn-danger btn-sm" <%= hasStarted(test.startTime) ? 'disabled' : '' %>>Delete</button>
                      </form>
                    </div>
                  </div>
                  <hr>
                <% } %>
              <% } else { %>
                <p class="text-muted">No tests yet</p>
              <% } %>
            </div>
            <% if (allTests && allTests.length > 5) { %>
              <div class="text-center mt-2">
                <button id="toggleTestsBtn" class="btn btn-sm btn-outline-primary">Show All Tests</button>
              </div>
            <% } %>

            <div class="mt-3">
              <form action="/upload" method="POST" enctype="multipart/form-data" class="row g-3 align-items-center">
                <div class="col-md-5">
                  <label for="branch" class="form-label">Select Branch</label>
                  <select class="form-select" id="branch" name="branch" required>
                    <option value="" disabled selected>Select branch</option>
                    <option value="lr">Logical Reasoning and Aptitude</option>
                    <option value="ai">Artificial Intelligence</option>
                    <option value="che">Chemical Engineering</option>
                    <option value="chm">Chemistry</option>
                    <option value="ce">Civil Engineering</option>
                    <option value="cse">Computer Science and Engineering</option>
                    <option value="ee">Electrical Engineering</option>
                    <option value="ece">Electronics Engineering</option>
                    <option value="hss">Humanities and Social Sciences</option>
                    <option value="ms">Management Studies</option>
                    <option value="math">Mathematics</option>
                    <option value="me">Mechanical Engineering</option>
                    <option value="phy">Physics</option>
                  </select>
                </div>
                <div class="col-md-5">
                  <label for="file" class="form-label">Upload Excel File</label>
                  <input class="form-control" type="file" id="file" name="file" accept=".xlsx,.xls" required>
                </div>
                <div class="col-12">
                  <div class="d-grid mt-2">
                    <button type="submit" class="btn btn-success w-100">Upload Questions</button>
                  </div>
                </div>
              </form>
            </div>

            
          </div>
        </div>
      </div>
    </div>

    <!-- Leaderboard -->
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h5 class="fw-bold mb-3">Leaderboard</h5>
        <div class="d-flex gap-2 mb-3">
          <select id="branchSelect" class="form-select w-auto">
            <option value="lr" selected>Logical Reasoning</option>
            <option value="ai">Artificial Intelligence</option>
            <option value="che">Chemical Engineering</option>
            <option value="chm">Chemistry</option>
            <option value="ce">Civil Engineering</option>
            <option value="cse">Computer Science & Engineering</option>
            <option value="ee">Electrical Engineering</option>
            <option value="ece">Electronics & Communication</option>
            <option value="hss">Humanities & Social Sciences</option>
            <option value="ms">Management Studies</option>
            <option value="math">Mathematics</option>
            <option value="me">Mechanical Engineering</option>
            <option value="phy">Physics</option>
          </select>
          <select id="testSelect" class="form-select w-auto">
            <option value="">Select Test</option>
          </select>
        </div>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Name</th>
                <th>Score</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="leaderboardBody"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="/js/dashboard.js"></script>
<script>
  // show only top 5 test items initially, toggle to show all
  (function(){
    const list = document.getElementById('testsList');
    const toggle = document.getElementById('toggleTestsBtn');
    if (!list || !toggle) return;
    const items = Array.from(list.querySelectorAll('.test-item'));
    const limit = 5;
    function updateVisibility(showAll){
      items.forEach((it, idx) => {
        if (idx >= limit) {
          it.style.display = showAll ? '' : 'none';
          // hide following hr as well
          const hr = it.nextElementSibling;
          if (hr && hr.tagName === 'HR') hr.style.display = showAll ? '' : 'none';
        }
      });
      toggle.textContent = showAll ? 'Show Top 5' : 'Show All Tests';
    }
    // initial state: show top 5
    updateVisibility(false);
    toggle.addEventListener('click', ()=>{
      const showingAll = toggle.textContent === 'Show Top 5';
      updateVisibility(!showingAll);
    });
  })();

  // announcements: show only top 5 initially, toggle to show all
  (function(){
    const list = document.querySelectorAll('.announcement-item');
    const toggle = document.getElementById('toggleAnnouncementsBtn');
    if (!list || !list.length || !toggle) return;
    const limit = 4;
    function updateAnnouncements(showAll){
      list.forEach((el, idx) => {
        if (idx >= limit) {
          el.style.display = showAll ? '' : 'none';
          const hr = el.nextElementSibling;
          if (hr && hr.tagName === 'HR') hr.style.display = showAll ? '' : 'none';
        }
      });
      toggle.textContent = showAll ? 'Show Top 5' : 'Show All Announcements';
    }
    updateAnnouncements(false);
    toggle.addEventListener('click', ()=>{
      const showingAll = toggle.textContent === 'Show Top 4';
      updateAnnouncements(!showingAll);
    });
  })();
</script>