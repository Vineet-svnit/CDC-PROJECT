<% layout("/layouts/userBoilerplate") %>

  <main class="py-5">
    <div class="container-lg">
      <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div style="width: 4px; height: 40px; background: #27496d; border-radius: 2px;"></div>
            <h1 class="h3 mb-0 fw-bold" style="color: #27496d;">
              <%= test.testName %>
            </h1>
          </div>
          <p class="text-muted">Review your submission and performance below.</p>
        </div>
      </div>

      <!-- <a href="http://localhost:5000/submission" id="sebQuitBtn" class="btn btn-danger" style="display:none;">
        Exit Exam Mode
      </a> -->


      <% const questions=test.questions || []; const answers=submission.submittedAns || []; let attemptedCount=0; for
        (let i=0; i < questions.length; i++) { const ans=answers[i] || {}; if ((ans.answer || ""
        ).toString().trim().length> 0) attemptedCount++;
        }

        const accuracy =
        test.totalMarks > 0
        ? Math.max((submission.score / test.totalMarks) * 100, 0)
        : 0;

        let correctMarksTotal = 0;
        let incorrectMarksTotal = 0;
        let unattemptedMarksTotal = 0;

        let correctQuestionsTotal = 0;
        let incorrectQuestionsTotal = 0;
        let unattemptedQuestionsTotal = 0;

        questions.forEach((q, i) => {
        const ans = answers[i] || {};
        const score = ans.score || 0;
        const attempted = (ans.answer || "").toString().trim().length > 0;
        const maxMarks = (q._type === 'MCQ') ? 4 : 3;

        if (!attempted) {
        unattemptedMarksTotal += maxMarks;
        unattemptedQuestionsTotal++;
        } else if (score > 0) {
        correctMarksTotal += score;
        correctQuestionsTotal++;
        } else {
        incorrectMarksTotal += Math.max(0, maxMarks - score);
        incorrectQuestionsTotal++;
        }
        });

        // Category-wise analysis
        const categoryStats = {};
        questions.forEach((q, i) => {
        const category = q.category || 'Uncategorized';
        if (!categoryStats[category]) {
        categoryStats[category] = {
        correct: 0,
        incorrect: 0,
        unattempted: 0,
        total: 0
        };
        }

        const ans = answers[i] || {};
        const score = ans.score || 0;
        const attempted = (ans.answer || "").toString().trim().length > 0;
        const maxMarks = (q._type === 'MCQ') ? 4 : 3;

        categoryStats[category].total++;

        if (!attempted) {
        categoryStats[category].unattempted++;
        } else if (score > 0) {
        categoryStats[category].correct++;
        } else {
        categoryStats[category].incorrect++;
        }
        });

        const categories = Object.keys(categoryStats);
        %>

        <div class="row mb-5">
          <div class="col-12">
            <div class="row g-3 mb-4">
              <div class="col-lg-3 col-md-6">
                <div class="card border-0 text-center p-4"
                  style="background: linear-gradient(135deg, #e0e7ff, #f3e8ff);">
                  <h6 class="text-muted mb-1">Total Questions</h6>
                  <h3 class="fw-bold mb-0" style="color:#27496d">
                    <%= questions.length %>
                  </h3>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="card border-0 text-center p-4"
                  style="background: linear-gradient(135deg, #dbeafe, #e0e7ff);">
                  <h6 class="text-muted mb-1">Attempted</h6>
                  <h3 class="fw-bold mb-0" style="color:#2b6cb0">
                    <%= attemptedCount %>
                  </h3>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="card border-0 text-center p-4"
                  style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
                  <h6 class="text-muted mb-1">Your Score</h6>
                  <h3 class="fw-bold mb-0" style="color:#27496d">
                    <%= submission.score %> / <%= test.totalMarks %>
                  </h3>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="card border-0 text-center p-4"
                  style="background: linear-gradient(135deg, #dcfce7, #bbf7d0);">
                  <h6 class="text-muted mb-1">Accuracy</h6>
                  <h3 class="fw-bold mb-0"
                    style="color:<%= accuracy >= 75 ? '#22c55e' : accuracy >= 30 ? '#f59e0b' : '#ef4444' %>">
                    <%= accuracy.toFixed(1) %>%
                  </h3>
                </div>
              </div>
            </div>
          </div>

          <div class="row justify-content-center mb-4">
            <div class="col-lg-4 col-md-6">
              <div class="card border-0 text-center p-4"
                style="background: linear-gradient(135deg, <%= submission.isQualified ? '#dcfce7, #bbf7d0' : '#fee2e2, #fecaca' %>);">
                <h6 class="text-muted mb-1">Overall Verdict</h6>
                <h3 class="fw-bold mb-0" style="color:<%= submission.isQualified ? '#15803d' : '#b91c1c' %>">
                  <%= submission.isQualified ? 'Qualified' : 'Not Qualified' %>
                </h3>
              </div>
            </div>
          </div>

        </div>
        <!-- <div class="col-lg-3 col-md-6">
             <div class="card border-0 text-center p-4" ... >
             </div> 
          </div> -->
    </div>

    <div class="row justify-content-center mb-5">
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm p-4 text-center">
          <h5 class="fw-bold mb-4" style="color:#27496d">Overall Performance</h5>
          <div style="height: 300px; position: relative;">
            <canvas id="performanceChart"></canvas>
          </div>
          <div class="mt-3 d-flex justify-content-center gap-4">
            <div class="d-flex align-items-center gap-2">
              <div style="width: 12px; height: 12px; border-radius: 50%; background: #22c55e;"></div>
              <small class="text-muted">Correct: <%= correctQuestionsTotal %></small>
            </div>
            <div class="d-flex align-items-center gap-2">
              <div style="width: 12px; height: 12px; border-radius: 50%; background: #ef4444;"></div>
              <small class="text-muted">Incorrect: <%= incorrectQuestionsTotal %></small>
            </div>
            <div class="d-flex align-items-center gap-2">
              <div style="width: 12px; height: 12px; border-radius: 50%; background: #94a3b8;"></div>
              <small class="text-muted">Unattempted: <%= unattemptedQuestionsTotal %></small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Category-wise Analysis Carousel -->
    <% if (categories.length> 0) { %>
      <div class="row">
        <div class="col-12">
          <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold mb-4 text-center" style="color:#27496d">Category-wise Analysis</h5>

            <div id="categoryCarousel" class="carousel slide" data-bs-ride="false">
              <!-- Indicators -->
              <div class="carousel-indicators">
                <% for (let i=0; i < Math.ceil(categories.length / 3); i++) { %>
                  <button type="button" data-bs-target="#categoryCarousel" data-bs-slide-to="<%= i %>"
                    class="<%= i === 0 ? 'active' : '' %>" aria-current="<%= i === 0 ? 'true' : 'false' %>"
                    aria-label="Slide <%= i + 1 %>"></button>
                  <% } %>
              </div>

              <!-- Carousel Items -->
              <div class="carousel-inner">
                <% for (let slideIndex=0; slideIndex < Math.ceil(categories.length / 3); slideIndex++) { %>
                  <div class="carousel-item <%= slideIndex === 0 ? 'active' : '' %>">
                    <div class="row g-4 px-3 py-4">
                      <% for (let i=slideIndex * 3; i < Math.min((slideIndex + 1) * 3, categories.length); i++) { const
                        category=categories[i]; const stats=categoryStats[category]; %>
                        <div class="col-lg-4 col-md-6">
                          <div class="card border-0 h-100"
                            style="background: linear-gradient(135deg, #f8fafc, #e2e8f0);">
                            <div class="card-body text-center">
                              <h6 class="fw-bold mb-1" style="color:#27496d">
                                <%= category %>
                              </h6>
                              <% const catResult=submission.categoryResults ? submission.categoryResults.find(r=>
                                r.category === category) : null;
                                const isCatQualified = catResult ? catResult.isQualified : false;
                                %>
                                <div class="mb-3">
                                  <span class="badge"
                                    style="background-color: <%= isCatQualified ? '#15803d' : '#b91c1c' %>">
                                    <%= isCatQualified ? 'Qualified' : 'Not Qualified' %>
                                  </span>
                                </div>
                                <div style="height: 200px; position: relative; margin-bottom: 1rem;">
                                  <canvas id="categoryChart<%= i %>"></canvas>
                                </div>
                                <div class="d-flex justify-content-center gap-3 flex-wrap">
                                  <div class="text-center">
                                    <div
                                      style="width: 10px; height: 10px; border-radius: 50%; background: #22c55e; margin: 0 auto 4px;">
                                    </div>
                                    <small class="text-muted d-block">Correct</small>
                                    <strong style="color:#22c55e">
                                      <%= stats.correct %>
                                    </strong>
                                  </div>
                                  <div class="text-center">
                                    <div
                                      style="width: 10px; height: 10px; border-radius: 50%; background: #ef4444; margin: 0 auto 4px;">
                                    </div>
                                    <small class="text-muted d-block">Incorrect</small>
                                    <strong style="color:#ef4444">
                                      <%= stats.incorrect %>
                                    </strong>
                                  </div>
                                  <div class="text-center">
                                    <div
                                      style="width: 10px; height: 10px; border-radius: 50%; background: #94a3b8; margin: 0 auto 4px;">
                                    </div>
                                    <small class="text-muted d-block">Unattempted</small>
                                    <strong style="color:#94a3b8">
                                      <%= stats.unattempted %>
                                    </strong>
                                  </div>
                                </div>
                                <div class="mt-2">
                                  <small class="text-muted">Total Questions: <strong>
                                      <%= stats.total %>
                                    </strong></small>
                                </div>
                            </div>
                          </div>
                        </div>
                        <% } %>
                    </div>
                  </div>
                  <% } %>
              </div>

              <!-- Controls -->
              <% if (categories.length> 3) { %>
                <button class="carousel-control-prev" type="button" data-bs-target="#categoryCarousel"
                  data-bs-slide="prev">
                  <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(1);"></span>
                  <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#categoryCarousel"
                  data-bs-slide="next">
                  <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(1);"></span>
                  <span class="visually-hidden">Next</span>
                </button>
                <% } %>
            </div>
          </div>
        </div>
      </div>
      <% } %>

        </div>
        </div>

        <div class="row">
          <div class="col-12">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-white border-bottom d-flex justify-content-between">
                <h5 class="fw-bold mb-0" style="color:#27496d">Detailed Review</h5>
                <button id="expandToggle" class="btn btn-sm btn-outline-primary">Expand All</button>
              </div>

              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Q.</th>
                      <th>Question</th>
                      <th>Your Answer</th>
                      <th>Correct</th>
                      <th>Score</th>
                      <th>Category</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (let i=0; i < questions.length; i++) { const q=questions[i] || {}; const ans=answers[i] ||
                      {}; const userAnswer=(ans.answer || "" ).toString(); const score=(ans.score !=null && ans.score
                      !==undefined) ? ans.score : 0; const attempted=userAnswer.trim().length> 0;
                      const correctAns = (q.answer || "").toString().trim();

                      const rowBgColor = attempted
                      ? score > 0 ? "#d4edda" : "#f8d7da"
                      : "#f1f5f9";
                      %>

                      <tr data-bs-toggle="collapse" data-bs-target="#opt-<%= i %>" style="cursor:pointer"
                        aria-controls="opt-<%= i %>">
                        <td style="background:<%= rowBgColor %>">
                          <%= i + 1 %>
                        </td>
                        <td style="background:<%= rowBgColor %>">
                          <div><strong>
                              <%= q.question %>
                            </strong></div>
                          <% if (q.questionImage) { %>
                            <img src="<%= q.questionImage %>" alt="question-image-<%= i %>"
                              style="max-width:120px; max-height:80px; border-radius:4px; margin-top:8px;">
                            <% } %>
                        </td>
                        <td style="background:<%= rowBgColor %>">
                          <%= userAnswer && userAnswer.trim().length ? userAnswer : "-" %>
                        </td>
                        <td style="background:<%= rowBgColor %>">
                          <%= correctAns %>
                        </td>
                        <td style="background:<%= rowBgColor %>">
                          <%= score %>
                        </td>
                        <td style="background:<%= rowBgColor %>">
                          <span class="badge" style="background-color: #27496d; font-size: 0.75rem;">
                            <%= q.category || 'N/A' %>
                          </span>
                        </td>
                      </tr>

                      <tr class="collapse" id="opt-<%= i %>">
                        <td colspan="6" class="p-0">
                          <div style="background:<%= rowBgColor %>; padding: 16px;">
                            <div class="options-container">
                              <% const opts=[q.option1, q.option2, q.option3, q.option4].filter(Boolean); for (let oi=0;
                                oi < opts.length; oi++) { const optRaw=opts[oi] || "" ; const opt=optRaw.toString();
                                const isCorrect=opt.trim()===correctAns; const isUser=opt.trim()===userAnswer.trim();
                                let optionClass="option-item" ; let badge="" ; if (isCorrect) { optionClass
                                +=" option-correct" ; badge='<span class="option-badge correct-badge">Correct</span>' ;
                                } else if (attempted && isUser && !isCorrect) { optionClass +=" option-incorrect" ;
                                badge='<span class="option-badge incorrect-badge">Your Answer</span>' ; } %>

                                <div class="<%= optionClass %>">
                                  <div class="option-content">
                                    <strong>
                                      <%= String.fromCharCode(65 + oi) %>.
                                    </strong>
                                    <%= opt %>
                                  </div>
                                  <div class="option-badge-container">
                                    <%= badge %>
                                  </div>
                                </div>

                                <% } %>
                            </div>
                          </div>
                        </td>
                      </tr>

                      <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        </div>
  </main>

  <style>
    .options-container {
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid #dee2e6;
    }

    .option-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background-color: white;
      border-bottom: 1px solid #dee2e6;
      transition: all 0.2s;
    }

    .option-item:last-child {
      border-bottom: none;
    }

    .option-correct {
      background-color: #198754 !important;
      color: white !important;
    }

    .option-incorrect {
      background-color: #dc3545 !important;
      color: white !important;
    }

    .option-content {
      flex: 1;
    }

    .option-badge-container {
      margin-left: 12px;
    }

    .option-badge {
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }

    .correct-badge {
      background-color: white;
      color: #198754;
    }

    .incorrect-badge {
      background-color: white;
      color: #dc3545;
    }

    /* Carousel styling */
    #categoryCarousel .carousel-control-prev,
    #categoryCarousel .carousel-control-next {
      width: 5%;
      opacity: 0.8;
    }

    #categoryCarousel .carousel-control-prev:hover,
    #categoryCarousel .carousel-control-next:hover {
      opacity: 1;
    }

    #categoryCarousel .carousel-control-prev-icon,
    #categoryCarousel .carousel-control-next-icon {
      /* background-color: #27496d; */
      border-radius: 50%;
      padding: 20px;
    }

    #categoryCarousel .carousel-control-prev-icon {
      margin-right: 60px;
    }

    #categoryCarousel .carousel-control-next-icon {
      margin-left: 60px;
    }

    #categoryCarousel .carousel-indicators {
      margin-bottom: -1rem;
    }

    #categoryCarousel .carousel-indicators button {
      background-color: #27496d;
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    #categoryCarousel .carousel-item {
      min-height: 350px;
    }
  </style>

  <script>
    (function () {
      const btn = document.getElementById("expandToggle");
      const categoryFilter = document.getElementById("categoryFilter");
      let open = false;

      // Expand/Collapse All functionality
      btn?.addEventListener("click", () => {
        document.querySelectorAll(".collapse").forEach(el => {
          const c = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
          open ? c.hide() : c.show();
        });
        btn.innerText = open ? "Expand All" : "Collapse All";
        open = !open;
      });

      // Category Filter functionality
      categoryFilter?.addEventListener("change", (e) => {
        const selectedCategory = e.target.value;
        const questionRows = document.querySelectorAll(".question-row");
        const detailRows = document.querySelectorAll(".question-detail");

        questionRows.forEach((row, index) => {
          const rowCategory = row.getAttribute("data-category");
          const detailRow = detailRows[index];

          if (selectedCategory === "all" || rowCategory === selectedCategory) {
            row.style.display = "";
            if (detailRow) {
              detailRow.style.display = "";
            }
          } else {
            row.style.display = "none";
            if (detailRow) {
              detailRow.style.display = "none";
              // Collapse the detail row if it's expanded
              const collapse = bootstrap.Collapse.getInstance(detailRow);
              if (collapse) {
                collapse.hide();
              }
            }
          }
        });

        // Reset expand/collapse button state
        open = false;
        btn.innerText = "Expand All";
      });
    })();
  </script>

  <script>
    // Overall Performance Chart
    (function () {
      const ctx = document.getElementById('performanceChart').getContext('2d');
      new Chart(ctx, {
        type: 'pie',
        data: {
          labels: ['Correct', 'Incorrect', 'Unattempted'],
          datasets: [{
            data: [<%= correctQuestionsTotal %>, <%= incorrectQuestionsTotal %>, <%= unattemptedQuestionsTotal %>],
            backgroundColor: ['#22c55e', '#ef4444', '#94a3b8'],
            borderWidth: 2,
            borderColor: '#fff',
            hoverOffset: 10
          }]
        },
        options: {
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              callbacks: {
                label: function (context) {
                  let label = context.label || '';
                  if (label) {
                    label += ': ';
                  }
                  if (context.parsed !== null) {
                    label += context.parsed + ' question' + (context.parsed !== 1 ? 's' : '');
                  }
                  return label;
                }
              }
            }
          },
          responsive: true,
          maintainAspectRatio: false
        }
      });
    })();

    // Category-wise Charts
    <% categories.forEach((category, index) => {
      const stats = categoryStats[category];
    %>
        (function () {
          const ctx = document.getElementById('categoryChart<%= index %>').getContext('2d');
          new Chart(ctx, {
            type: 'pie',
            data: {
              labels: ['Correct', 'Incorrect', 'Unattempted'],
              datasets: [{
                data: [<%= stats.correct %>, <%= stats.incorrect %>, <%= stats.unattempted %>],
                backgroundColor: ['#22c55e', '#ef4444', '#94a3b8'],
                borderWidth: 2,
                borderColor: '#fff',
                hoverOffset: 8
              }]
            },
            options: {
              plugins: {
                legend: {
                  display: false
                },
                tooltip: {
                  callbacks: {
                    label: function (context) {
                      let label = context.label || '';
                      if (label) {
                        label += ': ';
                      }
                      if (context.parsed !== null) {
                        label += context.parsed + ' question' + (context.parsed !== 1 ? 's' : '');
                      }
                      return label;
                    }
                  }
                }
              },
              responsive: true,
              maintainAspectRatio: false
            }
          });
        })();
    <% }); %>
  </script>
  </body>

