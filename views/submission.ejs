  <script>
    (function () {
      // Best-effort SEB detection on frontend
      const ua = navigator.userAgent || "";

      const isSEB =
        ua.includes("SEB") ||
        ua.includes("SafeExamBrowser");

      if (isSEB) {
        setTimeout(() => {
          window.location.href = "<%= isProd ? 'https://cdc-project-w2zb.onrender.com/randomquit' : 'http://localhost:5000/randomquit' %>";
        }, 5000); // delay in ms
      }
    })();
  </script>

  <script>
    (function () {
      const btn = document.getElementById("exitExamBtn");
      if (!btn) return;

      const ua = navigator.userAgent || "";

      const isSEB =
        ua.includes("SEB") ||
        ua.includes("SafeExamBrowser");

      if (isSEB) {
        btn.style.display = "inline-block";
      }
    })();
  </script>