<% layout('/layouts/adminBoilerplate') %>

<div class="card shadow-sm">
  <div class="card-body">
    <h4 class="fw-bold mb-3">Upload Summary</h4>
    <div class="mb-3">
      <strong>Inserted:</strong> <span class="ms-2"><%= inserted %></span>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <h6 class="mb-2">Errors</h6>
        <ul class="mb-0">
          <% errors.forEach(function(err) { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } else { %>
      <div class="alert alert-success">✓ No errors found</div>
    <% } %>
  </div>
</div>
