<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Source+Sans+3:wght@400;600&family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Mono:wght@400;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <title>CDC Admin</title>
</head>

<body style="background: var(--bg);">
  <header class="py-2 shadow-sm" style="background: #fff;">
    <div class="container-lg d-flex align-items-center">
      <a href="/" class="text-decoration-none d-flex align-items-center">
        <img src="/images/CDC Logo.png" alt="CDC Logo" height="70" class="me-3"
          style="margin-top: -10px; margin-bottom: -10px;">
        <h4 class="mb-0" style="color:#27496d">CDC Admin</h4>
      </a>
      <nav class="ms-auto">
        <a href="/admin/logout" class="btn btn-danger btn-sm">Logout</a>
      </nav>
    </div>
  </header>

  <main class="py-4">
    <div class="container-lg">
      <%- include("../includes/flash.ejs") %>
        <%- body %>
    </div>
  </main>

  <%- include("../includes/footer.ejs") %>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>