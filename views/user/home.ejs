<% layout("/layouts/userBoilerplate") %>

  <% const now=getCurrentUTC(); const upcomingTests=[]; const activeTests=[]; const inactiveTests=[]; for(let test of
    allTests) { const status=getTestStatus(test.startTime, test.endTime); if(status==='upcoming' ) {
    upcomingTests.push(test); } else if(status==='active' || status==='buffer' ) { activeTests.push(test); } else { inactiveTests.push(test);
    } } %>

    <main class="py-5">
      <div class="container-lg">

        <!-- Hero Section -->
        <div class="row align-items-center mb-5 pb-4 border-bottom">
          <div class="col-lg-8">
            <h1 class="display-5 fw-bold mb-3" style="color: #27496d;">Aptitude & Reasoning Tests</h1>
            <p class="lead text-muted">Common for all departments. Test your logical reasoning and aptitude skills.</p>
          </div>
          <div class="col-lg-4 text-end">
            <div class="stats-card">
              <div class="stat-box">
                <h5 class="mb-0" style="color: #27496d;">
                  <%= upcomingTests.length %>
                </h5>
                <small class="text-muted">Upcoming</small>
              </div>
              <div class="stat-box">
                <h5 class="mb-0" style="color: #2b6cb0;">
                  <%= activeTests.length %>
                </h5>
                <small class="text-muted">Active</small>
              </div>
              <div class="stat-box">
                <h5 class="mb-0" style="color: #6b7280;">
                  <%= inactiveTests.length %>
                </h5>
                <small class="text-muted">Completed</small>
              </div>
            </div>
          </div>
        </div>

        <!-- Active Tests Section (Priority) -->
        <% if (activeTests.length> 0) { %>
          <section class="mb-5">
            <div class="d-flex align-items-center gap-3 mb-4">
              <div style="width: 4px; height: 32px; background: #2b6cb0; border-radius: 2px;"></div>
              <h2 class="h4 mb-0 fw-bold" style="color: #27496d;">Active Tests</h2>
              <span class="badge bg-success">
                <%= activeTests.length %>
              </span>
            </div>
            <div class="row g-4">
              <% for(let test of activeTests){ %>
                <div class="col-md-6 col-lg-4">
                  <div class="card h-100 border-0 shadow-sm hover-shadow transition"
                    style="border-left: 4px solid #2b6cb0;">
                    <div class="card-body d-flex flex-column">
                      <h5 class="card-title fw-bold mb-3" style="color: #27496d;">
                        <%= test.testName %>
                      </h5>
                      <div class="test-info mb-3">
                        <p class="mb-2"><i class="far fa-calendar me-2"></i><small class="text-muted">
                            <%= formatDate(test.startTime) %>
                          </small></p>
                        <p class="mb-2"><i class="far fa-clock me-2"></i><small class="text-muted">
                            <%= formatTime(test.startTime) %>
                          </small></p>
                        <p class="mb-2"><i class="fas fa-hourglass me-2"></i><small class="text-muted">
                            <%= test.duration %> mins
                          </small></p>
                        <p class="mb-2"><i class="fas fa-question-circle me-2"></i><small class="text-muted">
                            <%= test.numberOfQues %> questions
                          </small></p>
                        <p><i class="fas fa-star me-2"></i><small class="text-muted">
                            <%= test.totalMarks %> marks
                          </small></p>
                      </div>
                      <a href="/tests/<%= test._id %>" class="btn btn-warning mt-auto"
                        id="<%= test._id %>">
                        <i class="fas fa-play me-2"></i><%= getTestStatus(test.startTime, test.endTime) === 'Start Test' ? 'Setup & Start Test' : 'Continue Test' %>
                      </a>
                    </div>
                  </div>
                </div>
                <% } %>
            </div>
          </section>
          <% } %>

            <!-- Upcoming Tests Section -->
            <% if (upcomingTests.length> 0) { %>
              <section class="mb-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                  <div style="width: 4px; height: 32px; background: #27496d; border-radius: 2px;"></div>
                  <h2 class="h4 mb-0 fw-bold" style="color: #27496d;">Upcoming Tests</h2>
                  <span class="badge bg-primary">
                    <%= upcomingTests.length %>
                  </span>
                </div>
                <div class="row g-4">
                  <% for(let test of upcomingTests){ %>
                    <div class="col-md-6 col-lg-4">
                      <div class="card h-100 border-0 shadow-sm hover-shadow transition">
                        <div class="card-body d-flex flex-column">
                          <h5 class="card-title fw-bold mb-3" style="color: #27496d;">
                            <%= test.testName %>
                          </h5>
                          <div class="test-info mb-3">
                            <p class="mb-2"><i class="far fa-calendar me-2"></i><small class="text-muted">
                                <%= formatDate(test.startTime) %>
                              </small></p>
                            <p class="mb-2"><i class="far fa-clock me-2"></i><small class="text-muted">
                                <%= formatTime(test.startTime) %>
                              </small></p>
                            <p class="mb-2"><i class="fas fa-hourglass me-2"></i><small class="text-muted">
                                <%= test.duration %> mins
                              </small></p>
                            <p class="mb-2"><i class="fas fa-question-circle me-2"></i><small class="text-muted">
                                <%= test.numberOfQues %> questions
                              </small></p>
                            <p><i class="fas fa-star me-2"></i><small class="text-muted">
                                <%= test.totalMarks %> marks
                              </small></p>
                          </div>
                          <a href="/tests/<%= test._id %>" class="btn btn-primary mt-auto"
                            id="<%= test._id %>">
                            <i class="fas fa-play me-2"></i>Start Test
                          </a>
                        </div>
                      </div>
                    </div>
                    <% } %>
                </div>
              </section>
              <% } %>

                <!-- Past Tests Section -->
                <% if (inactiveTests.length> 0) { %>
                  <section>
                    <div class="d-flex align-items-center gap-3 mb-4">
                      <div style="width: 4px; height: 32px; background: #9ca3af; border-radius: 2px;"></div>
                      <h2 class="h4 mb-0 fw-bold" style="color: #27496d;">Past Tests</h2>
                      <span class="badge bg-secondary">
                        <%= inactiveTests.length %>
                      </span>
                    </div>
                    <div class="row g-4">
                      <% for(let test of inactiveTests){ %>
                        <div class="col-md-6 col-lg-4">
                          <div class="card h-100 border-0 shadow-sm opacity-75">
                            <div class="card-body d-flex flex-column">
                              <h5 class="card-title fw-bold mb-3" style="color: #27496d;">
                                <%= test.testName %>
                              </h5>
                              <div class="test-info mb-3">
                                <p class="mb-2"><i class="far fa-calendar me-2"></i><small class="text-muted">
                                    <%= formatDate(test.startTime) %>
                                  </small></p>
                                <p class="mb-2"><i class="far fa-clock me-2"></i><small class="text-muted">
                                    <%= formatTime(test.startTime) %>
                                  </small></p>
                                <p class="mb-2"><i class="fas fa-hourglass me-2"></i><small class="text-muted">
                                    <%= test.duration %> mins
                                  </small></p>
                                <p class="mb-2"><i class="fas fa-question-circle me-2"></i><small class="text-muted">
                                    <%= test.numberOfQues %> questions
                                  </small></p>
                                <p><i class="fas fa-star me-2"></i><small class="text-muted">
                                    <%= test.totalMarks %> marks
                                  </small></p>
                              </div>
                              <button class="btn btn-secondary mt-auto" disabled>
                                <i class="fas fa-check me-2"></i>Completed
                              </button>
                            </div>
                          </div>
                        </div>
                        <% } %>
                    </div>
                  </section>
                  <% } %>

                    <!-- Empty State -->
                    <% if (allTests.length===0) { %>
                      <div class="text-center py-5">
                        <i class="fas fa-inbox fa-3x text-muted mb-3" style="opacity: 0.5;"></i>
                        <h4 class="text-muted">No aptitude tests available</h4>
                        <p class="text-muted">Check back soon for upcoming exams.</p>
                      </div>
                      <% } %>

      </div>
    </main>

    <style>
      .hover-shadow {
        transition: box-shadow 0.3s ease, transform 0.2s ease;
      }

      .hover-shadow:hover {
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12) !important;
        transform: translateY(-2px);
      }

      .stats-card {
        display: flex;
        gap: 12px;
      }

      .stat-box {
        background: #f5f7fa;
        padding: 12px 16px;
        border-radius: 8px;
        text-align: center;
      }

      .test-info p {
        margin: 0;
      }
    </style>