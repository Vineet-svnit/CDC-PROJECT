<% layout("/layouts/userBoilerplate") %>

<main class="py-5">
  <div class="container-lg">
    <div class="row mb-4">
      <div class="col-lg-8 mx-auto">
        <div class="d-flex align-items-center gap-3 mb-4">
          <div style="width: 4px; height: 40px; background: #27496d; border-radius: 2px;"></div>
          <h1 class="h3 mb-0 fw-bold" style="color: #27496d;">Announcements</h1>
        </div>
        <p class="text-muted">Latest updates and important notifications for you.</p>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-8 mx-auto">
        <% if (allAnnouncements && allAnnouncements.length > 0) { %>
          <% for(announcement of allAnnouncements){ %>
            <div class="card border-0 shadow-sm mb-4 hover-card transition">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                  <h5 class="card-title fw-bold mb-0" style="color: #27496d;">
                    <%= announcement.title %>
                  </h5>
                  <small class="text-muted bg-light px-2 py-1 rounded">
                    <i class="far fa-calendar me-1"></i><%= announcement.date %>
                  </small>
                </div>
                
                <div class="announcement-body text-muted mb-3">
                  <%- announcement.body %>
                </div>
                
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                  <small class="text-secondary">
                    <i class="fas fa-user me-1"></i>By <%= announcement.issued_by %>
                  </small>
                </div>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <div class="text-center py-5">
            <i class="fas fa-bell fa-3x text-muted mb-3" style="opacity: 0.5;"></i>
            <h5 class="text-muted">No announcements yet</h5>
            <p class="text-muted">Check back soon for updates.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<style>
  .hover-card {
    transition: all 0.3s ease;
  }
  .hover-card:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
    transform: translateY(-2px);
  }
  .announcement-body {
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .announcement-body img {
    max-width: 100%;
    height: auto;
    margin-top: 12px;
    border-radius: 8px;
  }
</style>